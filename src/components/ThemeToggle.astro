---
// Light/dark switch. The initial theme is applied by the inline script in
// BaseLayout <head> (before first paint); this button only flips and saves it.
---

<button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">
  <!-- Sun: shown in dark mode (click for light) -->
  <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <!-- Moon: shown in light mode (click for dark) -->
  <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s, transform 0.3s;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    transform: rotate(15deg);
  }

  .icon-moon {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }
</style>

<script>
  const THEME_COLORS = { dark: '#000814', light: '#F4F5FA' } as const;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function syncButton(theme: 'dark' | 'light') {
    if (!toggle) return;
    const next = theme === 'light' ? 'dark' : 'light';
    const label = `Switch to ${next} theme`;
    toggle.setAttribute('aria-label', label);
    toggle.setAttribute('title', label);
  }

  function currentTheme(): 'dark' | 'light' {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  syncButton(currentTheme());

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[next]);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable (private mode etc.) — theme still applies for this page view
    }
    syncButton(next);
  });
</script>
